// VS Code Dev Container for the development stack. See oci/DEVELOPMENT.md, "Use VS Code Dev Containers".
{
  "name": "FreezeMan",
  // The project name comes from `name: freezeman` of compose.yaml, so VS Code uses the same
  // containers and volumes as `podman-compose` in a shell. podman-compose reads oci/.env.
  "dockerComposeFile": ["../oci/compose.yaml", "../oci/compose.dev.yaml"],
  "service": "dev",
  "runServices": ["db", "dev"],
  // devcontainer.json cannot read oci/.env. Keep this path equal to CONTAINER_FMS_ROOT there.
  "workspaceFolder": "/workspace/freezeman",
  "shutdownAction": "stopCompose",
  // Keep the entrypoint of the image: it waits for the database before `sleep infinity`.
  "overrideCommand": false,
  // compose.dev.yaml runs `dev` with `userns_mode: keep-id`, which already gives the host UID.
  // Without this, VS Code builds an extra image to change the UID.
  "updateRemoteUserUID": false,
  // No forwardPorts: compose.dev.yaml publishes 8000, 9000 and 5432. A forward of the same port
  // conflicts with them.
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.debugpy",
        "dbaeumer.vscode-eslint"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/opt/venv/bin/python"
      }
    }
  }
}
