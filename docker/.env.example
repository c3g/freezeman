# Copy to docker/.env and adjust. docker/.env is git-ignored.
# Variable names match backend/fms/settings.py, so this file can later become
# a Kubernetes ConfigMap (plain settings) and Secret (passwords, keys).

# --- Database (used by the db container; the backend's PG_* are derived from these) ---
POSTGRES_DB=fms
POSTGRES_USER=admin
POSTGRES_PASSWORD=change-me

# --- Django ---
# Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
FMS_SECRET_KEY=change-me
# PROD, QC or DEV. Anything but PROD also writes backend/fms.log.
FMS_ENV=PROD
FMS_DEBUG=False
# Public hostname of the server
FMS_HOST=localhost
# Extra comma-separated hosts Django accepts (healthchecks, direct access)
FMS_EXTRA_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# --- Email (if FMS_EMAIL_HOST is unset, emails are logged to the console) ---
#FMS_EMAIL_HOST=smtp.office365.com
#FMS_EMAIL_PORT=587
#FMS_EMAIL_FROM=noreply@example.com
#FMS_EMAIL_USER=noreply@example.com
#FMS_EMAIL_PASSWORD=secret
#FMS_EMAIL_TLS=True

# --- Trigger and automation directories (defaults are inside the backend volumes) ---
#FMS_RUN_INFO_PATH=
#FMS_VALIDATED_FILES_PATH=
#FMS_RELEASED_FILES_PATH=
#FMS_AUTOMATIONS_WORK_PATH=

# --- Containers ---
# gunicorn worker processes
WEB_CONCURRENCY=3
# Host port nginx is published on
FMS_HTTP_PORT=8080
# Tag for the built images (e.g. the release version)
FMS_IMAGE_TAG=latest
