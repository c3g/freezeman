# Template of oci/.env on a server (production or test host). For development, use .env.dev.example.
#
# The values are those of the C3G production host (checkout in /data/freezeman). Personalize the
# file before the first start:
#   1. Copy it: cp .env.prod.example .env
#   2. Replace each `change-me` value.
#   3. Set the required values that are empty: FMS_IMAGE_TAG and HOST_LOG_DIR.
#   4. On a host other than C3G production, also change FMS_HOST, the FMS_EMAIL_* values and the
#      host paths of section 3.
#   5. After each later change, run `podman-compose up -d --force-recreate`. `restart` keeps the
#      old values.
#
# The comment above each variable tells what it does, if it is required, and when to change it.
# A comment gives the default only for a variable that the file does not set.
# DEPLOYMENT.md links to this file and does not repeat these explanations.

# ==================================================================================================
# 1. Container settings: compose passes them into the containers.
# ==================================================================================================

# Database name, user and password of the db container. The backend uses the same values.
# Set a new password.
POSTGRES_DB=fms
POSTGRES_USER=admin
POSTGRES_PASSWORD=change-me

# Django secret key. Set a new value. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
FMS_SECRET_KEY=change-me

# Required. PROD on the production host, QC or DEV on a test host. Do not use LOCAL on a server:
# it is the value of the development stack. The effects of each value are in DEPLOYMENT.md,
# "FMS_ENV values". The web image gets the value at build time, so after a change run
# `podman-compose build web`, then `podman-compose up -d --force-recreate`.
FMS_ENV=PROD

# Django debug mode. Keep False on a server.
FMS_DEBUG=False

# Public domain of the site. Django accepts only this Host header (and localhost when FMS_ENV is
# not PROD).
FMS_HOST=biobank.genome.mcgill.ca

# SMTP server of the emails (for example the password reset emails).
# - If the host has no route to the SMTP server, see DEPLOYMENT.md, "Network access".
# - To turn TLS off, leave FMS_EMAIL_TLS empty.
# - To log the emails to the console instead, comment out all six lines. An empty value is not the
#   same as a missing line: an empty FMS_EMAIL_HOST still turns on SMTP.
FMS_EMAIL_HOST=smtp-mail.outlook.com
FMS_EMAIL_PORT=587
FMS_EMAIL_FROM=freezeman.genome@mcgill.ca
FMS_EMAIL_USER=freezeman.genome@mcgill.ca
FMS_EMAIL_PASSWORD=change-me
FMS_EMAIL_TLS=True

# Number of uwsgi worker processes in the backend container.
UWSGI_PROCESSES=8

# Time zone of all services and their logs, for example America/Montreal.
# Django still stores dates in UTC, so a change does not change the stored data.
TZ=America/Montreal

# ==================================================================================================
# 2. Build settings: podman-compose uses them when it builds the images.
# ==================================================================================================

# Tag of the images that podman-compose builds and starts. Set it to the value in the VERSION
# file of the project root (for example 5.9.0). update-production-deployment.sh sets it at each
# update.
# Required when FMS_ENV is PROD: freezeman.py, jobs.py and autoupdate.py stop if it is empty.
# On other FMS_ENV values the default is latest.
FMS_IMAGE_TAG=

# Required. Path of the project inside the containers. Keep this value. After a change, rebuild
# all images.
CONTAINER_FMS_ROOT=/workspace/freezeman

# Proxy for the image builds. Set these only if the host reaches the internet through an HTTP
# proxy and the shell that runs podman-compose does not set them. Details: DEPLOYMENT.md, "Proxy".
# - A value in the shell wins over the value here.
# - Image pulls do not read this file. They need the proxy in the shell.
# - NO_PROXY always gets db, backend and web. You do not add them.
# Default: empty (NO_PROXY: localhost,127.0.0.1).
#HTTP_PROXY=http://proxy.example.com:3128
#HTTPS_PROXY=http://proxy.example.com:3128
#NO_PROXY=localhost,127.0.0.1

# ==================================================================================================
# 3. Host settings: paths and ports on the host. Only compose and the host scripts read them.
#    The paths are those of C3G production. Change them on another host.
# ==================================================================================================

# Required. Absolute path of an existing host directory for all the logs: the log of each
# container (<service>.log), the Django log (fms.log) and the logs of the host scripts.
# Use logs/ of the checkout (<install-dir>/logs, /data/freezeman/logs on C3G production).
# A relative path or a missing directory gives
# "[conmon:e]: Failed to open log file No such file or directory".
HOST_LOG_DIR=

# Host folders of the backend data. Compose binds each one at a fixed path in the backend
# container, so the files stay where they are on the host. podman-compose creates a missing folder.
# To use the folder in the checkout instead, comment out the line (the default is in parentheses).

# Uploaded files, served as /media/ (backend/media).
HOST_MEDIA_DIR=/data/freezeman/backend/media

# Run info triggers (backend/triggers/lims-run-info).
HOST_RUN_INFO_DIR=/data/freezeman-lims-run-info

# Validated dataset triggers (backend/triggers/lims-validation-info).
HOST_VALIDATED_FILES_DIR=/data/freezeman-lims-validated

# Released dataset triggers (backend/triggers/lims-release-info).
HOST_RELEASED_FILES_DIR=/data/freezeman-lims-released

# Work files of the automations (backend/automations_work).
HOST_AUTOMATIONS_WORK_DIR=/data/freezeman-automations

# Host port of the web container. The reverse proxy of the host sends the requests to this port
# (proxy_pass, 8080 in the C3G IT config).
HOST_HTTP_PORT=8080

# Host address of the published port. Keep 127.0.0.1, so only the reverse proxy reaches it.
# Use 0.0.0.0 only for a local test in a VM or container. Default 127.0.0.1.
#HOST_HTTP_ADDR=127.0.0.1
