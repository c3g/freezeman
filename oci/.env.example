# Copy to oci/.env and adjust. oci/.env is git-ignored.
# Variable names match backend/fms/settings.py, so this file can later become
# a Kubernetes ConfigMap (plain settings) and Secret (passwords, keys).

# --- Database (used by the db container; the backend's PG_* are derived from these) ---
POSTGRES_DB=fms
POSTGRES_USER=admin
POSTGRES_PASSWORD=change-me

# --- Django ---
# Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
FMS_SECRET_KEY=change-me
# PROD, QC or DEV. Anything but PROD also writes backend/fms.log.
FMS_ENV=PROD
FMS_DEBUG=False
# Public hostname of the server
FMS_HOST=localhost

# --- Email (if FMS_EMAIL_HOST is unset, emails are logged to the console) ---
#FMS_EMAIL_HOST=smtp.office365.com
#FMS_EMAIL_PORT=587
#FMS_EMAIL_FROM=noreply@example.com
#FMS_EMAIL_USER=noreply@example.com
#FMS_EMAIL_PASSWORD=secret
#FMS_EMAIL_TLS=True

# --- Trigger and automation directories (defaults are inside the backend volumes) ---
#FMS_RUN_INFO_PATH=
#FMS_VALIDATED_FILES_PATH=
#FMS_RELEASED_FILES_PATH=
#FMS_AUTOMATIONS_WORK_PATH=

# --- Daily report data (report service) ---
# Time of day (HH:MM, in TZ) for prepare_report_data
FMS_REPORT_TIME=02:00
# prepare_report_data uses America/Montreal
TZ=America/Montreal

# --- Database backup (backup service) ---
# Host directory for the daily <YYYY-MM-DD>.pgsql.gz dumps. It must exist.
# Default: oci/backups (relative to the compose file).
#FMS_BACKUP_DIR=/data/freezeman/backups
# Time of day (HH:MM, in TZ) of the backup
FMS_BACKUP_TIME=01:00
# Delete backups older than this many days (0 keeps all)
FMS_BACKUP_KEEP_DAYS=14

# --- Host nginx paths (defaults are relative to oci/, so they match DEPLOYMENT.md when the
# repository is at /data/freezeman). The directories must exist. ---
# "assets" service: built frontend (nginx root) and Django static files (nginx /static/)
#FMS_FRONTEND_DIST_DIR=/data/freezeman/frontend/dist
#FMS_STATIC_DIR=/data/freezeman/backend/staticfiles
# Uploaded files (nginx /media/), written by the backend
#FMS_MEDIA_DIR=/data/freezeman/backend/media
# Directory of the uwsgi unix socket fms.sock (nginx uwsgi_pass)
#FMS_SOCKET_DIR=/data/freezeman/backend
# Trigger folders, read by the backend
#FMS_TRIGGERS_DIR=/data/freezeman/backend/triggers

# --- Containers ---
# Host directory for the container logs: one file per service (<service>.log). It must exist,
# and the path must be absolute. The files stay after `down` and `--force-recreate`.
# Default: logs/ in the directory of the compose file, when you run podman-compose from there.
# Set it when an editor (Dev Container) starts compose from another directory.
#FMS_LOG_DIR=/data/freezeman/oci/logs
# uwsgi worker processes
UWSGI_PROCESSES=3
# Host port of the container nginx. Used only with `podman-compose --profile web up -d`
FMS_HTTP_PORT=8080
# Tag for the built images (e.g. the release version)
FMS_IMAGE_TAG=latest
