# Copy to oci/.env and run `podman-compose up -d --force-recreate` in oci/ after each change,
# because `restart` keeps the old values.

# ==================================================================================================
# 1. Container settings: compose passes them into the containers with the names of
#    backend/fms/settings.py.
# ==================================================================================================

# Database of the db container, from which the backend derives its PG_* settings.
POSTGRES_DB=fms
POSTGRES_USER=admin
POSTGRES_PASSWORD=change-me

# Generate with `python3 -c "import secrets; print(secrets.token_urlsafe(50))"`.
FMS_SECRET_KEY=change-me

# PROD, QC or DEV, also a build argument of the web image, so run `podman-compose build web` after
# a change.
FMS_ENV=PROD

FMS_DEBUG=False

# Public domain of the stack (DEPLOYMENT.md, or localhost for a local test), the only Host header
# that Django accepts.
FMS_HOST=<domain>

# Without FMS_EMAIL_HOST, the backend logs emails to the console.
#FMS_EMAIL_HOST=smtp.office365.com
#FMS_EMAIL_PORT=587
#FMS_EMAIL_FROM=noreply@example.com
#FMS_EMAIL_USER=noreply@example.com
#FMS_EMAIL_PASSWORD=secret
#FMS_EMAIL_TLS=True

# Number of uwsgi worker processes in the backend container.
UWSGI_PROCESSES=3

# Time zone of all services and their logs (default UTC, example America/Montreal). Django still
# stores dates in UTC (TIME_ZONE in backend/fms/settings.py), so TZ does not change stored data.
TZ=UTC

# ==================================================================================================
# 2. Build settings: podman-compose uses them when it builds the images.
# ==================================================================================================

# Tag of the built images, which `up` also runs (for example the release version).
FMS_IMAGE_TAG=latest

# Required path of the project in the containers, used by the builds and the mount targets, so
# rebuild all images after a change.
CONTAINER_FMS_ROOT=/workspace/freezeman

# Proxy for the builds and the dev container, needed only when compose starts without the shell
# proxy (a shell value wins, NO_PROXY always gets db, backend and web, and image pulls still need
# the shell proxy).
#HTTP_PROXY=http://proxy.example.com:3128
#HTTPS_PROXY=http://proxy.example.com:3128
#NO_PROXY=localhost,127.0.0.1

# ==================================================================================================
# 3. Host settings: absolute host paths and ports that only compose and the host scripts read, where
#    <install-dir> is the checkout path (DEPLOYMENT.md).
# ==================================================================================================

# Required existing host directory for the per-service container logs (development: oci/logs of
# your checkout).
HOST_LOG_DIR=<install-dir>/oci/logs

# Host folder for uploaded files, served as /media/, created if missing (default: backend/media).
#HOST_MEDIA_DIR=

# Host folder for the run info triggers, created if missing
# (default: backend/triggers/lims-run-info).
#HOST_RUN_INFO_DIR=

# Host folder for the validated dataset triggers, created if missing
# (default: backend/triggers/lims-validation-info).
#HOST_VALIDATED_FILES_DIR=

# Host folder for the released dataset triggers, created if missing
# (default: backend/triggers/lims-release-info).
#HOST_RELEASED_FILES_DIR=

# Host folder for the work files of the automations, created if missing
# (default: backend/automations_work).
#HOST_AUTOMATIONS_WORK_DIR=

# Host port of the web nginx, which must match the host nginx proxy_pass (8080 in the IT config).
HOST_HTTP_PORT=8080

# Host address of the published port (0.0.0.0 only for a local test in a VM or container).
#HOST_HTTP_ADDR=127.0.0.1
