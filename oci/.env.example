# Copy to oci/.env and adjust. oci/.env is git-ignored.
# After a change, run `podman-compose up -d --force-recreate` in oci/ (`restart` keeps the old values).
# Variable names match backend/fms/settings.py.

# --- Database (used by the db container; the backend's PG_* are derived from these) ---
POSTGRES_DB=fms
POSTGRES_USER=admin
POSTGRES_PASSWORD=change-me

# --- Django ---
# Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
FMS_SECRET_KEY=change-me
# PROD, QC or DEV. Anything but PROD also writes /workspace/freezeman/backend/fms.log inside the
# backend container. It is not on the host and is lost when the container is recreated.
# The web image gets FMS_ENV when it is built: after a change, run `podman-compose build web`
# before `podman-compose up -d --force-recreate` (DEPLOYMENT.md).
FMS_ENV=PROD
FMS_DEBUG=False
# Public hostname of the server: the domain of the stack (server_name of the HTTPS server block).
# Django rejects other Host headers.
# <domain>: see DEPLOYMENT.md. Local test of the production stack: localhost.
FMS_HOST=<domain>

# --- Email (if FMS_EMAIL_HOST is unset, emails are logged to the console) ---
#FMS_EMAIL_HOST=smtp.office365.com
#FMS_EMAIL_PORT=587
#FMS_EMAIL_FROM=noreply@example.com
#FMS_EMAIL_USER=noreply@example.com
#FMS_EMAIL_PASSWORD=secret
#FMS_EMAIL_TLS=True

# --- Proxy (image builds and the dev container) ---
# Leave this block empty (commented out) when the host has no proxy. A value in the shell
# environment wins over a value here. Set them here only when compose starts without the shell
# proxy. Image pulls still need the proxy in the shell (README.md: "Proxy").
# Use the uppercase names. Compose sets the lowercase forms from them.
# NO_PROXY: the service names db, backend and web are always added.
#HTTP_PROXY=http://proxy.example.com:3128
#HTTPS_PROXY=http://proxy.example.com:3128
#NO_PROXY=localhost,127.0.0.1

# --- Time zone ---
# Time zone of all services and their logs (db, backend, jobs, web).
# Default: UTC. Example: America/Montreal
TZ=UTC

# --- Daily jobs (jobs service) ---
# Host cron runs the report, the backup and the log rotation with oci/jobs.py, one crontab line per
# job. The crontab sets the times (DEPLOYMENT.md, "Daily jobs").

# --- Database backup ---
# Host directory for the daily <YYYY-MM-DD>.pgsql.gz dumps. podman-compose creates it if it is missing.
# Use an absolute path. <install-dir>: the absolute path of the checkout (DEPLOYMENT.md).
# Default (not set): <install-dir>/oci/backups, a directory of the checkout.
#FMS_BACKUP_DIR=
# Delete backups older than this many days, but always keep the newest
# FMS_BACKUP_KEEP_DAYS backups (0 keeps all)
FMS_BACKUP_KEEP_DAYS=14

# --- Log rotation ---
# How often each log rotates: daily, weekly, monthly or yearly
FMS_LOGROTATE_FREQUENCY=weekly
# Number of rotated files to keep for each log (8 weekly files are about 8 weeks)
FMS_LOGROTATE_KEEP=8

# --- Host folders of the backend files ---
# Compose binds each folder at a fixed path in the backend container, so the files stay where they
# are on the host (for example the folders of a classic install). podman-compose creates a missing folder. Use
# absolute paths. Default (not set): the folder in the checkout (backend/media,
# backend/triggers/lims-run-info, lims-validation-info, lims-release-info, backend/automations_work).
# FMS_RUN_INFO_PATH, FMS_VALIDATED_FILES_PATH, FMS_RELEASED_FILES_PATH and FMS_AUTOMATIONS_WORK_PATH
# are host paths here. Compose gives the backend the fixed container paths.
# Uploaded files (served by the web nginx as /media/), written by the backend
#FMS_MEDIA_DIR=
# Trigger folders, written by the backend: run info, validated datasets, released datasets
#FMS_RUN_INFO_PATH=
#FMS_VALIDATED_FILES_PATH=
#FMS_RELEASED_FILES_PATH=
# Work directory of the automations
#FMS_AUTOMATIONS_WORK_PATH=

# --- Containers ---
# Host directory for the container logs: one file per service (<service>.log). Required: compose
# stops without it. The directory must exist, and the path must be absolute. The files stay after
# `down` and `--force-recreate`.
# <install-dir>: the absolute path of the checkout (DEPLOYMENT.md). Development: the absolute path of oci/logs in your checkout.
FMS_LOG_DIR=<install-dir>/oci/logs
# uwsgi worker processes
UWSGI_PROCESSES=3
# Host port of the web nginx. The host nginx proxy_pass uses it: it must match the IT config (8080).
FMS_HTTP_PORT=8080
# Host address of the published port. Set 0.0.0.0 only for a local test in a VM or container.
#FMS_HTTP_ADDR=127.0.0.1
# Tag for the built images (e.g. the release version)
FMS_IMAGE_TAG=latest
