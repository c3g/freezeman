# Rendered by the nginx image entrypoint (envsubst) into /etc/nginx/conf.d/default.conf.
# Only variables defined in the environment are substituted, so nginx's own
# $uri, $host, ... are left untouched.

# HTTPS=on makes uwsgi set wsgi.url_scheme=https, so Django builds https URLs
# (request.build_absolute_uri) behind an outer TLS proxy (host nginx, Ingress)
# without SECURE_PROXY_SSL_HEADER. Direct access falls back to our own $https.
map $http_x_forwarded_proto $fms_https {
    https   on;
    default $https;
}

server {
    listen 8080;
    server_name _;

    # Same values as the production host nginx.
    client_max_body_size 50m;
    client_body_timeout 300s;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    root /usr/share/nginx/html;
    index index.html;

    # Single-page application built by webpack
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Django collectstatic output, baked into this image
    location /static/ {
        alias /usr/share/nginx/static/;
    }

    # Uploaded files, shared with the backend through the media volume
    location /media/ {
        alias /var/www/media/;
    }

    location /api/ {
        include uwsgi_params;
        uwsgi_param HTTPS $fms_https if_not_empty;
        uwsgi_pass ${BACKEND_UPSTREAM};
        uwsgi_read_timeout 300s;
    }

    location = /favicon.ico {
        access_log off;
        log_not_found off;
    }
}
