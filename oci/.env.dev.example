# Template of oci/.env for development: the development stack (DEVELOPMENT.md) and the local test of
# the production stack. For a server, use .env.prod.example. Run `podman-compose up -d
# --force-recreate` in oci/ after each change, because `restart` keeps the old values.

# ==================================================================================================
# 1. Container settings: compose passes them into the containers with the names of
#    backend/fms/settings.py.
# ==================================================================================================

# Database of the db container, from which the backend derives its PG_* settings. The password and
# the secret key below are for a local stack only.
POSTGRES_DB=fms
POSTGRES_USER=admin
POSTGRES_PASSWORD=dev-password

FMS_SECRET_KEY=dev-only-insecure-key

# Required by compose.yaml. The dev container always uses LOCAL (compose.dev.yaml). The value here
# applies to the local test of the production stack. It is also a build argument of the web image,
# so run `podman-compose build web` after a change.
FMS_ENV=DEV

FMS_DEBUG=True

# The only Host header that Django accepts, with localhost.
FMS_HOST=localhost

# Without FMS_EMAIL_*, the backend logs emails to the console.

# Time zone of all services and their logs. Django still stores dates in UTC (TIME_ZONE in
# backend/fms/settings.py), so TZ does not change stored data.
TZ=UTC

# ==================================================================================================
# 2. Build settings: podman-compose uses them when it builds the images.
# ==================================================================================================

# Required tag of the built images, which `up` also runs. It has no default: compose stops if it
# is not set or empty.
FMS_IMAGE_TAG=latest

# Required path of the project in the containers, used by the builds and the mount targets, so
# rebuild all images after a change.
CONTAINER_FMS_ROOT=/workspace/freezeman

# Proxy for the builds and the dev container, needed only when compose starts without the shell
# proxy (a shell value wins, NO_PROXY always gets db, backend and web, and image pulls still need
# the shell proxy).
#HTTP_PROXY=http://proxy.example.com:3128
#HTTPS_PROXY=http://proxy.example.com:3128
#NO_PROXY=localhost,127.0.0.1

# ==================================================================================================
# 3. Host settings: absolute host paths and ports that only compose and the host scripts read.
#    The data folders (HOST_MEDIA_DIR and the others, see .env.prod.example) default to the folders
#    in the checkout.
# ==================================================================================================

# Required existing host directory for the per-service container logs: the absolute path of
# oci/logs in your checkout.
HOST_LOG_DIR=<checkout>/oci/logs

# Host port of the web nginx in the local test of the production stack.
HOST_HTTP_PORT=8080

# Host address of the published port. Uncomment in a VM or container.
#HOST_HTTP_ADDR=0.0.0.0
