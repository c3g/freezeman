# Template of oci/.env for development: the development stack (DEVELOPMENT.md) and the local test of
# the production stack. For a production server, use .env.prod.example.
#
# Personalize the file before the first start:
#   1. Copy it: cp .env.dev.example .env
#   2. Set HOST_LOG_DIR (required, empty here).
#   3. After each later change, run `podman-compose up -d --force-recreate`. `restart` keeps the
#      old values.
#
# The comment above each variable tells what it does, if it is required, and when to change it.
# A comment gives the default only for a variable that the file does not set.
# .env.prod.example explains the variables that this file leaves out.

# ==================================================================================================
# 1. Container settings: compose passes them into the containers.
# ==================================================================================================

# Database name, and user and password of the app role. The backend connects with these values.
# db creates the role on the first start of a new volume (db/initdb/20-app-role.sh). The superuser
# is postgres, through the Unix socket of the db container only.
# Default database: fms.
#POSTGRES_DB=fms
# Required. Keep it in this file: the db service sets its own POSTGRES_USER (postgres), and
# podman-compose would use that value for the app role if .env had none.
POSTGRES_USER=admin
POSTGRES_PASSWORD=dev-password

# Django secret key. The dev container uses the development key of settings.py if this line is
# commented out. Uncomment it for the local test of the production stack (compose.yaml needs it).
#FMS_SECRET_KEY=dev-only-key

# Required by compose.yaml. The dev container always uses LOCAL (compose.dev.yaml), so this value
# applies only to the local test of the production stack. The web image gets the value at build
# time, so after a change run `podman-compose build web`.
FMS_ENV=LOCAL

# Django debug mode.
FMS_DEBUG=True

# Django accepts only this Host header and localhost.
FMS_HOST=localhost

# No FMS_EMAIL_* values: the backend logs the emails to the console. Default: empty.

# Time zone of all services and their logs.
# Django still stores dates in UTC, so a change does not change the stored data.
TZ=UTC

# ==================================================================================================
# 2. Build settings: podman-compose uses them when it builds the images.
# ==================================================================================================

# Tag of the images that podman-compose builds and starts.
FMS_IMAGE_TAG=local

# ==================================================================================================
# 3. Host settings: paths and ports on the host. Only compose and the host scripts read them.
#    The data folders (HOST_MEDIA_DIR and the others, see .env.prod.example) default to the
#    folders in the checkout.
# ==================================================================================================

# Required. Absolute path of an existing host directory for all the logs: the log of each
# container (<service>.log) and the Django log (fms.log). Use logs/ of your checkout, for example
# /home/me/freezeman/logs.
# A relative path or a missing directory gives
# "[conmon:e]: Failed to open log file No such file or directory".
HOST_LOG_DIR=

# Host port of the database in the development stack. Change it if the host runs its own
# PostgreSQL on 5432. Default 5432.
#HOST_DB_PORT=5432

# Host port of the web container in the local test of the production stack.
HOST_HTTP_PORT=8080

# Host address of the published port. Default 127.0.0.1. Uncomment in a VM or container.
#HOST_HTTP_ADDR=0.0.0.0
