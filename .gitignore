# Ignore the contents of the container log and backup directories. Keep oci/logs in the checkout:
# podman does not create the directory of a k8s-file log. podman-compose creates oci/backups (bind source).
oci/backups/
oci/logs/*
!oci/logs/.keep
# Rendered logrotate config and state (the template stays tracked).
oci/logrotate/logrotate.conf
oci/logrotate/*.state

# Database dumps
*.dump
*.pgdump
*.pgsql
*.sql.gz
*.dump.gz
*.pgsql.gz
